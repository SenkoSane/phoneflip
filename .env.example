# Kopieer naar .env.local (lokaal) en naar Netlify/Cloudflare environment variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Niet VITE_ — komt niet in de app-bundle. Alleen lokaal voor `npm run dev` (proxy).
# Live: plak de key op Backup, of zet OPENAI_API_KEY in Netlify als je functions deploys.
OPENAI_API_KEY=

